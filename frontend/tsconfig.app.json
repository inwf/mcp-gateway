{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness.
       Stated rather than inherited: which of these a TypeScript release
       turns on by default has changed before, and a type checker that
       silently relaxes is worse than no type checker. */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths are relative to this file. baseUrl is deliberately absent:
       TypeScript 6 deprecates it, and it is not needed once the
       patterns are relative. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // Reads the repository's own files, so it belongs to the node-side
  // project rather than to the browser bundle. See tsconfig.node.json.
  "exclude": ["src/styles/tokens.test.ts"]
}
